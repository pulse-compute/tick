{
  "name": "@pulse-compute/tick",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental interval coordination from unreliable triggers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulse-compute/tick.git"
  },
  "homepage": "https://github.com/pulse-compute/tick#readme",
  "bugs": {
    "url": "https://github.com/pulse-compute/tick/issues"
  },
  "keywords": ["edge", "fastly", "interval", "coordination", "kv", "s3"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm test && npm run proof:smoke",
    "test": "npm run test:contracts && npm run test:bindings && npm run test:conformance && npm run test:core && npm run test:runner && npm run test:trigger && npm run test:adapters && npm run test:proof && npm run test:kv-proof && npm run test:s3-proof && npm run test:monitor && npm run test:release",
    "build": "tsc -p tsconfig.json",
    "proof:local": "node proof/scripts/local-server.mjs",
    "proof:burst": "node proof/scripts/burst.mjs",
    "proof:analyze": "node proof/scripts/analyze.mjs",
    "proof:smoke": "node proof/scripts/smoke.mjs",
    "proof:build": "js-compute-runtime proof/src/fastly.js bin/main.wasm",
    "test:contracts": "npm run build && tsc -p test/types/tsconfig.json && node scripts/check-package.mjs",
    "test:proof": "node --test proof/test/*.test.mjs",
    "prepack": "npm run build",
    "test:adapters": "node --test test/adapters/*.test.mjs",
    "test:core": "node --test test/core/*.test.mjs",
    "test:runner": "node --test test/runner/*.test.mjs",
    "test:trigger": "node --test test/trigger/*.test.mjs",
    "test:bindings": "node --test test/bindings/*.test.mjs",
    "test:conformance": "node --test test/conformance/*.test.mjs",
    "test:kv-proof": "node --test proof/kv/test/*.test.mjs",
    "proof:kv:build": "npm run build && js-compute-runtime proof/kv/src/fastly.js proof/kv/bin/main.wasm",
    "proof:kv": "node proof/kv/run.mjs",
    "proof:kv:smoke": "node proof/kv/smoke.mjs",
    "proof:trigger:burst": "node proof/trigger/burst.mjs",
    "proof:trigger:build": "npm run build && js-compute-runtime proof/trigger/src/fastly.js proof/trigger/bin/main.wasm",
    "proof:trigger:smoke": "node proof/trigger/smoke.mjs",
    "test:s3-proof": "node --test proof/s3/test/*.test.mjs",
    "proof:s3:build": "npm run build && js-compute-runtime proof/s3/src/fastly.js proof/s3/bin/main.wasm",
    "proof:s3": "node proof/s3/run.mjs",
    "proof:s3:smoke": "node proof/s3/smoke.mjs",
    "monitor:build": "npm run build && tsc -p apps/http-monitor/tsconfig.json",
    "test:monitor": "npm run monitor:build && node --test apps/http-monitor/test/*.test.mjs && node apps/http-monitor/standalone-check.mjs",
    "monitor:guest:build": "npm run monitor:build && js-compute-runtime apps/http-monitor/fastly.js apps/http-monitor/bin/main.wasm",
    "monitor:guest:smoke": "node apps/http-monitor/smoke.mjs",
    "monitor:node": "npm run monitor:build && node apps/http-monitor/node.mjs",
    "package:artifact": "node scripts/prepare-artifact.mjs",
    "package:release": "node scripts/prepare-release.mjs",
    "test:release": "node --test test/release/*.test.mjs"
  },
  "devDependencies": {
    "@fastly/js-compute": "3.45.0",
    "typescript": "5.9.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js",
      "default": "./dist/runner.js"
    },
    "./cancellation": {
      "types": "./dist/cancellation.d.ts",
      "import": "./dist/cancellation.js",
      "default": "./dist/cancellation.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "import": "./dist/bindings.js",
      "default": "./dist/bindings.js"
    },
    "./testing/conformance": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js",
      "default": "./dist/testing/conformance.js"
    },
    "./adapters/fastly-trigger": {
      "types": "./dist/adapters/fastly-trigger.d.ts",
      "import": "./dist/adapters/fastly-trigger.js",
      "default": "./dist/adapters/fastly-trigger.js"
    },
    "./adapters/fastly-kv": {
      "types": "./dist/adapters/fastly-kv.d.ts",
      "import": "./dist/adapters/fastly-kv.js",
      "default": "./dist/adapters/fastly-kv.js"
    },
    "./adapters/s3": {
      "types": "./dist/adapters/s3.d.ts",
      "import": "./dist/adapters/s3.js",
      "default": "./dist/adapters/s3.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/architecture.md",
    "docs/fastly-kv.md",
    "docs/core.md",
    "docs/execution.md",
    "docs/trigger.md",
    "docs/bindings.md",
    "docs/conformance.md",
    "docs/s3.md",
    "docs/operations.md",
    "docs/release.md"
  ],
  "sideEffects": false
}
